# Supabase Configuration
# Replace these with your project credentials from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key

# Required by the multiplayer API. Set ONLY on the server (never NEXT_PUBLIC_*).
# Use your project's secret key, or set SUPABASE_SERVICE_ROLE_KEY instead for a legacy key.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Optional stable signing secret for guest sessions. Defaults to the server Supabase key.
# Set a long random value to preserve guest identities when rotating Supabase keys.
# MULTIPLAYER_SESSION_SECRET=

# App URL for OAuth redirects (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
